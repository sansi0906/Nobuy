/* pages/about/about.wxss */

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
  margin-bottom: 24rpx
}
.logo {
  width: 144rpx;
  height: 160rpx;
}
.name {
  margin-top: 24rpx;
  font-size: 32rpx; font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}
.slogan {
  margin-top: 8rpx;
  font-size: 24rpx; color: var(--ink-2);
}

.card { margin-bottom: 24rpx }

.sec-title {
  font-size: 24rpx; font-weight: 600; color: var(--ink-2);
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}
.sec-body {
  font-size: 24rpx; color: var(--ink);
  line-height: 1.8;
  margin-bottom: 16rpx;
}
.sec-body:last-child { margin-bottom: 0; }

/* 功能条目 */
.item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.item:last-child { margin-bottom: 0; }
.item-no {
  width: 48rpx; flex-shrink: 0;
  font-size: 24rpx; color: var(--ink-3);
  letter-spacing: 1rpx;
}
.item-text {
  flex: 1;
  font-size: 24rpx; color: var(--ink);
  line-height: 1.7;
}

/* 版本等键值行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
.row + .row { border-top: 1rpx solid var(--line); }
.row-label {
  font-size: 24rpx; color: var(--ink-2);
}
.row-value {
  font-size: 24rpx; color: var(--ink);
}
.row-arrow {
  font-size: 24rpx; color: var(--ink-3);
}

.footer {
  margin: 32rpx 8rpx 24rpx;
  text-align: center;
  font-size: 22rpx; color: var(--ink-3);
  line-height: 1.7;
}
