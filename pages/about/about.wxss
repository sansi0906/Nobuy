/* pages/about/about.wxss */

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx 48rpx;
  margin-bottom: 24rpx;
}
.logo {
  width: 160rpx;
  height: 180rpx;
}
.name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}
.slogan {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--accent-deep);
}
.desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
  line-height: 1.7;
}

.card { margin-bottom: 24rpx; }

.sec-title {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}
.sec-body {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
}

/* 开发者名片 */
.dev-card { padding: 32rpx; }
.dev-row {
  display: flex;
  align-items: center;
}
.dev-avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}
.dev-info { margin-left: 24rpx; flex: 1; }
.dev-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.dev-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}
.contact-btn {
  margin-top: 28rpx;
  width: 100%;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}
