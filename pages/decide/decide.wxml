<!--pages/decide/decide.wxml-->
<view class="page">

  <view class="head">
    <view class="head-name">{{item.name}}</view>
    <view class="head-price" wx:if="{{item.price}}">¥{{item.price}}</view>
    <view class="head-tip">买之前，花 30 秒过一遍这几个问题</view>
  </view>

  <view class="card" wx:for="{{questions}}" wx:key="q" wx:for-index="qi">
    <view class="q-num">问题 {{qi + 1}}</view>
    <view class="q-text">{{item.q}}</view>
    <view class="opts">
      <view wx:for="{{item.options}}" wx:key="*this" wx:for-index="oi"
            class="opt {{answers[qi] === oi ? 'opt-active' : ''}}"
            data-q="{{qi}}" data-opt="{{oi}}" bindtap="pick">{{item}}</view>
    </view>
  </view>

  <view class="actions">
    <view class="btn btn-ghost" bindtap="cancel">再想想</view>
    <view class="btn {{action === 'buy' ? 'btn-buy' : 'btn-nope'}}" bindtap="confirm">
      {{action === 'buy' ? '确认买了' : '确认不买了'}}
    </view>
  </view>
</view>
