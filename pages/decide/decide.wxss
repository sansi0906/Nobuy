/* pages/decide/decide.wxss */

.head {
  text-align: center;
  padding: 24rpx 0 32rpx;
}
.head-name {
  font-size: 38rpx; font-weight: 700; color: var(--ink);
}
.head-price {
  margin-top: 8rpx; font-size: 30rpx; color: var(--accent-deep); font-weight: 600;
}
.head-tip {
  margin-top: 12rpx; font-size: 24rpx; color: var(--ink-3);
}

.card {
  background: #fff; border-radius: 24rpx; padding: 32rpx;
  margin-bottom: 24rpx;
}
.q-num {
  font-size: 22rpx; color: var(--accent); font-weight: 600;
  margin-bottom: 12rpx;
}
.q-text {
  font-size: 28rpx; color: var(--ink); line-height: 1.6;
  margin-bottom: 20rpx;
}
.opts { display: flex; flex-wrap: wrap; margin: -8rpx; }
.opt {
  margin: 8rpx; padding: 16rpx 28rpx; border-radius: 999rpx;
  background: #F5F2EC; color: var(--ink-2); font-size: 26rpx;
  border: 1rpx solid transparent;
}
.opt-active {
  background: var(--accent-soft); color: var(--accent-deep);
  border-color: var(--accent); font-weight: 600;
}

.actions {
  margin-top: 32rpx;
  display: flex; gap: 24rpx;
}
.actions .btn { flex: 1; padding: 24rpx 0; }
.btn-buy  { background: var(--done-bg);  color: var(--done-text); font-weight: 600; }
.btn-nope { background: #EFEFEA; color: #5C5C54; font-weight: 600; }
