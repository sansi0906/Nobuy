/* pages/decide/decide.wxss */

.head {
  text-align: center;
  padding: 24rpx 0 32rpx
}
.head-name {
  font-size: 36rpx; font-weight: 700; color: var(--ink);
}
.head-price {
  margin-top: 10rpx; font-size: 44rpx; color: var(--ink); font-weight: 600;
  font-family: "Songti SC", "Noto Serif CJK SC", "Times New Roman", serif;
}
.head-qty { font-size: 24rpx; font-weight: 400; color: var(--ink-2); }
.head-total { margin-top: 4rpx; font-size: 24rpx; color: var(--ink-2); }
.head-tip {
  margin-top: 12rpx; font-size: 24rpx; color: var(--ink-3);
}

.card {
  background: var(--card); border: 1rpx solid var(--line);
  border-radius: 24rpx; padding: 32rpx;
  margin-bottom: 24rpx
}
.q-text {
  font-size: 24rpx; color: var(--ink); line-height: 1.6;
  margin-bottom: 24rpx
}
.opts { display: flex; flex-wrap: wrap; margin: -8rpx }
.opt {
  margin: 8rpx; padding: 16rpx 24rpx; border-radius: 999rpx; background: var(--n-25); color: var(--n-600); font-size: 24rpx; border: 1rpx solid var(--n-100);
}
.opt-active {
  background: var(--accent-soft); color: var(--accent-deep);
  border-color: var(--a-100); font-weight: 600;
}

.actions {
  margin-top: 32rpx;
  display: flex;
}
.actions .btn { flex: 1; padding: 24rpx 0 }
.btn-buy  { background: var(--card); color: var(--ink); font-weight: 600; border: 2rpx solid var(--n-200); }
.btn-nope { background: var(--accent); color: var(--on-accent); font-weight: 700; border: none; }
.btn-nope:active { background: var(--accent-deep); }

/* 兼容老客户端：不用 flex 的 gap，改用相邻按钮外边距 */
.btn + .btn { margin-left: 24rpx; }
