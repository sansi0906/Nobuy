/* pages/index/index.wxss —— v1.2.4 冷静底方案 */
.num-serif {
  font-family: "Songti SC", "Noto Serif CJK SC", "Times New Roman", serif;
  font-variant-numeric: tabular-nums;
}

/* 顶部：头像 + 昵称 */
.hero { padding: 8rpx 8rpx 24rpx }
.hero-row { display: flex; align-items: center; }
.hero-avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  flex-shrink: 0; background: var(--n-0); box-sizing: border-box;
}
.hero-avatar-default { padding: 12rpx; background: var(--accent-soft); }
.hero-text { flex: 1; margin-left: 24rpx }
.hero-name { font-size: 34rpx; font-weight: 700; color: var(--ink); letter-spacing: 1rpx; }
.hero-name-empty { font-weight: 400; color: var(--ink-3); }
.hero-sub { font-size: 24rpx; color: var(--ink-2); margin-top: 8rpx }
.hero-arrow { font-size: 28rpx; color: var(--ink-3); margin-left: 8rpx }

/* 战绩条：白卡 + 衬线数字 */
.result-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-3);
}
.result-bar:active { background: var(--n-25); }
.result-text { font-size: 24rpx; color: var(--ink-2); }
.result-strong {
  color: var(--ink); font-weight: 700; font-size: 30rpx;
  font-family: "Songti SC", "Noto Serif CJK SC", "Times New Roman", serif;
}
.result-dot { margin: 0 10rpx; color: var(--ink-3); }
.result-arrow { font-size: 26rpx; color: var(--ink-3); }
.result-right { display: flex; align-items: center; flex-shrink: 0; margin-left: 16rpx; }
.result-link { font-size: 24rpx; color: var(--accent-deep); font-weight: 600; margin-right: 4rpx; }

/* 待决定：橙软底一条 */
.pending {
  display: flex; align-items: center;
  background: var(--accent-soft);
  border-radius: var(--r-2); padding: 20rpx 24rpx;
  margin-bottom: 28rpx
}
.pending-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--accent);
  margin-right: 16rpx;
  animation: pulse 1.6s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.25); }
}
.pending-text { flex: 1; min-width: 0; font-size: 24rpx; color: var(--accent-deep); font-weight: 500; }
.pending-arrow { font-size: 26rpx; color: var(--accent-deep); opacity: 0.7; margin-left: 8rpx }
.pending:active { background: var(--a-100); }

/* 三段切换：文字 + 橙下划线，不用胶囊底槽 */
.seg {
  display: flex;
  align-items: flex-end;
  margin: 8rpx 0 24rpx;
  padding: 0 4rpx;
}
.seg-item {
  position: relative;
  margin-right: 48rpx;
  padding: 12rpx 0 18rpx;
  font-size: 26rpx; color: var(--ink-3);
}
.seg-active { color: var(--ink); font-weight: 700; }
.seg-active::after {
  content: '';
  position: absolute; left: 0; right: 0; bottom: 0;
  height: 4rpx; border-radius: 2rpx;
  background: var(--accent);
}
.seg-count {
  display: inline-block; margin-left: 8rpx;
  font-size: 20rpx; font-weight: 500; color: var(--accent-deep);
}
.seg-active .seg-count { color: var(--accent); }

/* 列表顶部入口：轻，不抢 FAB */
.top-add {
  display: flex; align-items: center;
  padding: 8rpx 0 20rpx;
  font-size: 26rpx; color: var(--accent-deep); font-weight: 500;
}
.top-add:active { opacity: 0.6; }

/* 记录卡 */
.item {
  position: relative;
  margin-bottom: 20rpx;
  display: flex; align-items: center;
  padding-left: 36rpx;
  overflow: hidden;
}
.item::before {
  content: '';
  position: absolute; left: 0; top: 28rpx; bottom: 28rpx;
  width: 6rpx; border-radius: 0 6rpx 6rpx 0;
  background: var(--accent);
}
.item-expired::before { background: var(--accent-deep); }
.item-body { flex: 1; min-width: 0; }

.item-del {
  width: 60rpx; height: 60rpx; flex-shrink: 0;
  margin-left: 16rpx; border-radius: 12rpx; background: var(--danger);
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.item-del::after {
  content: '';
  position: absolute;
  top: -16rpx; right: -16rpx; bottom: -16rpx; left: -16rpx;
}
.item-del:active { background: var(--s-danger-press); }
.item-del-icon { width: 36rpx; height: 36rpx; }

.item-top { display: flex; align-items: baseline; }
.item-name {
  font-size: 32rpx; font-weight: 600; color: var(--ink);
  flex: 1; min-width: 0; margin-right: 16rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.item-price {
  font-size: 32rpx; font-weight: 600; color: var(--ink);
  flex-shrink: 0; max-width: 44%; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis; text-align: right;
  font-family: "Songti SC", "Noto Serif CJK SC", "Times New Roman", serif;
}
.item-qty { font-size: 22rpx; font-weight: 400; color: var(--ink-3); font-family: inherit; }

.item-cat {
  display: inline-block;
  margin-top: 10rpx;
  padding: 2rpx 12rpx;
  font-size: 22rpx; color: var(--ink-3);
  background: var(--n-25);
  border-radius: 8rpx; }
.item-remark {
  margin-top: 10rpx; font-size: 24rpx; color: var(--ink-2);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

/* 倒计时：去掉色块，做成一行橙字 */
.cd-bar {
  margin-top: 16rpx;
  display: flex; align-items: baseline; justify-content: space-between;
}
.cd-value {
  font-size: 26rpx; font-weight: 700;
  font-family: "Songti SC", "Noto Serif CJK SC", "Times New Roman", serif;
}
.cd-bar-counting .cd-value { color: var(--accent); }
.cd-bar-expired .cd-value { color: var(--accent-deep); }
.cd-cta { font-size: 24rpx; color: var(--accent-deep); font-weight: 600; }

.item-date { margin-top: 12rpx; font-size: 22rpx; color: var(--ink-3); }

/* 首次引导 */
.onboard-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(20, 27, 31, 0.5);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
  animation: mask-in var(--dur-2) var(--ease-out) both;
}
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
.onboard-card {
  width: 580rpx; background: var(--card);
  border-radius: var(--r-3); padding: 48rpx 32rpx 32rpx;
  display: flex; flex-direction: column;
  box-shadow: var(--sh-2);
  animation: sheet-in var(--dur-3) var(--ease-out) both;
}
@keyframes sheet-in {
  from { opacity: 0; transform: translateY(24rpx) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.onboard-logo { width: 96rpx; height: 96rpx; align-self: center; }
.onboard-title { margin-top: 16rpx; margin-bottom: 32rpx; text-align: center; font-size: 32rpx; font-weight: 700; color: var(--ink); }
.onboard-step { display: flex; align-items: flex-start; margin-bottom: 24rpx }
.onboard-num {
  width: 32rpx; height: 40rpx; line-height: 40rpx; flex-shrink: 0;
  text-align: center; border-radius: 8rpx;
  background: var(--accent-soft); color: var(--accent-deep);
  font-size: 22rpx; font-weight: 700; margin-right: 16rpx
}
.onboard-txt { flex: 1; font-size: 24rpx; color: var(--ink); line-height: 1.6; }
.onboard-note { margin-top: 8rpx; font-size: 22rpx; color: var(--ink-3); line-height: 1.6; }
.onboard-btn { margin-top: 32rpx }

/* 空状态 */
.empty { margin-top: 96rpx; display: flex; flex-direction: column; align-items: center; }
.empty-logo { width: 152rpx; height: 152rpx; opacity: 0.92; }
.empty-title { margin-top: 32rpx; font-size: 32rpx; font-weight: 700; color: var(--ink); }
.empty-sub { margin-top: 10rpx; font-size: 24rpx; color: var(--ink-2); text-align: center; }
.empty-btn { margin-top: 44rpx; width: 420rpx; }

/* FAB：橙色胶囊，带字 */
.fab {
  position: fixed; right: 40rpx; bottom: 56rpx;
  display: flex; align-items: center; justify-content: center;
  height: 96rpx; padding: 0 36rpx;
  border-radius: 999rpx;
  background: var(--accent); color: #FFFFFF;
  font-size: 28rpx; font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(204, 94, 58, 0.28);
}
.fab:active { background: var(--accent-deep); }
