/* pages/index/index.wxss */

.hero { padding: 16rpx 8rpx 24rpx; }
.hero-row { display: flex; align-items: center; }
.logo { width: 76rpx; height: 86rpx; flex-shrink: 0; }
.hero-text { flex: 1; margin-left: 16rpx; }
.hero-title { font-size: 36rpx; font-weight: 700; color: var(--ink); letter-spacing: 1rpx; }
.hero-sub { font-size: 24rpx; color: var(--ink-2); margin-top: 4rpx; }
.hero-hello { margin-top: 16rpx; font-size: 24rpx; color: var(--accent-deep); padding-left: 8rpx; }

/* 待决定 banner */
.pending {
  display: flex; align-items: center;
  background: var(--accent-soft);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}
.pending-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--accent);
  margin-right: 14rpx;
  animation: pulse 1.6s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.2); }
}
.pending-text { font-size: 26rpx; color: var(--accent-deep); font-weight: 500; }

/* 三段切换 */
.seg {
  display: flex;
  background: rgba(255,255,255,0.6);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1; text-align: center;
  padding: 14rpx 0; font-size: 26rpx; color: var(--ink-2);
  border-radius: 999rpx;
}
.seg-active {
  background: #fff; color: var(--accent-deep); font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(120,90,60,0.08);
}
.seg-count { display: inline-block; margin-left: 6rpx; font-size: 20rpx; color: var(--ink-3); }
.seg-active .seg-count { color: var(--accent); }

/* 列表顶部加记录按钮 */
.top-add {
  background: var(--accent-soft);
  color: var(--accent-deep);
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}
.top-add:active { opacity: 0.7; }

/* 卡片 */
.item { margin-bottom: 20rpx; }
.item-top { display: flex; align-items: center; justify-content: space-between; }
.item-name {
  font-size: 32rpx; font-weight: 600; color: var(--ink);
  flex: 1; margin-right: 16rpx;
}
.item-price { font-size: 28rpx; font-weight: 600; color: var(--accent-deep); }
.item-remark {
  margin-top: 10rpx; font-size: 26rpx; color: var(--ink-2);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

.cd-bar {
  margin-top: 20rpx; padding: 16rpx 24rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.cd-bar-counting { background: var(--cooling-bg); }
.cd-bar-expired  { background: var(--accent-soft); }
.cd-value { font-size: 26rpx; font-weight: 600; }
.cd-bar-counting .cd-value { color: var(--cooling-text); }
.cd-bar-expired  .cd-value { color: var(--accent-deep); }
.cd-cta { font-size: 24rpx; color: var(--accent-deep); }

.item-date {
  margin-top: 16rpx; font-size: 22rpx; color: var(--ink-3);
}

/* 空状态 */
.empty { margin-top: 100rpx; display: flex; flex-direction: column; align-items: center; }
.empty-logo { width: 180rpx; height: 200rpx; opacity: 0.7; }
.empty-title { margin-top: 32rpx; font-size: 30rpx; font-weight: 600; color: var(--ink); }
.empty-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-2); }
.empty-btn { margin-top: 48rpx; width: 420rpx; }

.fab {
  position: fixed; right: 40rpx; bottom: 60rpx;
  width: 108rpx; height: 108rpx; border-radius: 50%;
  background: var(--accent); color: #fff;
  font-size: 56rpx; line-height: 108rpx; text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(201,123,74,0.35);
}
.fab:active { background: var(--accent-deep); }
