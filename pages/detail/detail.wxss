/* pages/detail/detail.wxss */

.main { margin-bottom: 24rpx }

/* 卡片抬头：状态标签 + 右上角编辑 */
.main-head {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 56rpx;
}
.edit-chip {
  font-size: 24rpx; color: var(--accent-deep);
  background: var(--accent-soft);
  padding: 8rpx 24rpx; border-radius: 999rpx; border: 1rpx solid var(--a-100);
}
.edit-chip:active { background: var(--a-100); }

.extend-tip { margin-top: 12rpx; font-size: 22rpx; color: var(--ink-3); }

.tag-lg { font-size: 24rpx; padding: 8rpx 24rpx }
.tag-cooling   { background: var(--cooling-bg); color: var(--cooling-text); }
.tag-skipped   { background: var(--n-25); color: var(--n-600); }
.tag-bought    { background: var(--done-bg); color: var(--done-text); }

.d-name { margin-top: 24rpx; font-size: 44rpx; font-weight: 700; color: var(--ink); line-height: 1.3; letter-spacing: 0.5rpx; }
.d-price {
  margin-top: 10rpx; font-size: 44rpx; font-weight: 600; color: var(--ink);
  font-family: "Songti SC", "Noto Serif CJK SC", "Times New Roman", serif;
}
.d-remark { margin-top: 16rpx; font-size: 28rpx; color: var(--ink-2); line-height: 1.6; }
.d-qty { font-size: 24rpx; font-weight: 400; color: var(--ink-2); }

/* 编辑态 */
.edit-block { margin-top: 24rpx }
.edit-label { font-size: 24rpx; color: var(--ink-3); margin-bottom: 12rpx }
.d-edit-name {
  font-size: 32rpx; font-weight: 600; color: var(--ink);
  border-bottom: 1rpx solid var(--line); padding-bottom: 12rpx
}
.d-edit-remark { font-size: 24rpx; color: var(--ink); min-height: 72rpx; width: 100%; }

.edit-price-row { display: flex; align-items: center; }
.edit-price {
  flex: 1; min-width: 0; font-size: 28rpx; color: var(--ink);
  border-bottom: 1rpx solid var(--line); padding: 8rpx 0 12rpx
}
.qty-ctrl { display: flex; align-items: center; margin-left: 24rpx }
.qty-btn {
  width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center;
  border-radius: 50%; background: var(--n-25); color: var(--ink); font-size: 28rpx; }
.qty-btn:active { background: var(--n-50); }
.qty-num {
  min-width: 60rpx; text-align: center; font-size: 28rpx; color: var(--ink); font-weight: 600;
}

.edit-cats { display: flex; flex-wrap: wrap; }
.edit-cat {
  margin: 0 12rpx 12rpx 0; padding: 12rpx 28rpx;
  font-size: 28rpx; color: var(--ink-2); background: var(--n-25);
  border-radius: 999rpx; }
.edit-cat-active { background: var(--accent-soft); color: var(--accent-deep); font-weight: 600; }

.cd-row {
  margin-top: 32rpx; padding: 20rpx 0 8rpx 24rpx;
  border-left: 6rpx solid var(--accent); border-radius: 0 12rpx 12rpx 0;
  background: var(--n-25);
}
.cd-row-expired { border-left-color: var(--accent-deep); }
.cd-text {
  font-size: 44rpx; font-weight: 700; color: var(--accent);
  font-family: "Songti SC", "Noto Serif CJK SC", "Times New Roman", serif;
}
.cd-row-expired .cd-text { color: var(--accent-deep); }

.meta { margin-bottom: 32rpx; padding: 12rpx 32rpx }
.meta-row { display: flex; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.meta-row:last-child { border-bottom: none; }
.meta-row .k { color: var(--ink-2); font-size: 24rpx; }
.meta-row .v { color: var(--ink); font-size: 24rpx; }

/* 决定按钮 */
.decide-row {
  display: flex; gap: 24rpx; margin-bottom: 16rpx
}
.decide-row .btn { flex: 1; padding: 24rpx 0; font-size: 28rpx; }
.btn-nope {
  background: var(--accent); color: var(--on-accent); font-weight: 700;
  border: none;
}
.btn-nope:active { background: var(--accent-deep); }
.btn-buy {
  background: var(--card); color: var(--ink); font-weight: 600;
  border: 2rpx solid var(--n-200);
}
.btn-buy:active { background: var(--n-25); }

/* 次级按钮 */
.btn-block { margin-bottom: 16rpx }
.btn-row { display: flex; gap: 24rpx; margin-bottom: 16rpx }
.btn-row .btn { flex: 1 }
.sub { margin-bottom: 16rpx }

/* ---- 成果卡 ---- */
/* 画布放在屏幕外，只用来出图，不参与布局 */
.card-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 540px;
  height: 720px;
}
.card-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(16, 24, 29, 0.55);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
  animation: card-fade var(--dur-2, .22s) var(--ease-out, ease-out) both;
}
@keyframes card-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
.card-box { width: 600rpx; display: flex; flex-direction: column; align-items: center; }
.card-loading {
  width: 600rpx; height: 800rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--n-0); border-radius: 24rpx;
  font-size: 26rpx; color: var(--ink-2);
}
.card-img {
  width: 600rpx; height: 800rpx;
  border-radius: 24rpx;
  background: var(--n-0);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.18);
}
.card-btns { display: flex; gap: 24rpx; width: 100%; margin-top: 32rpx }
.card-btns .btn { flex: 1 }
.card-hint { margin-top: 20rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.82) }

.actions { display: flex; gap: 24rpx; margin-bottom: 16rpx }
.actions .btn { flex: 1; }

/* 返回 */


/* ============ 深色模式补充 ============ */
/* 选中分类、编辑胶囊同样要比卡片底更亮一档，否则看不出来 */
@media (prefers-color-scheme: dark) {
  .edit-cat-active {
    background: var(--n-100);
    color: var(--n-900);
  }
  .edit-chip {
    background: var(--a-100);
    border-color: var(--a-600);
  }
  .edit-chip:active { background: var(--n-100); }
}
