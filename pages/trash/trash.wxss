/* pages/trash/trash.wxss */

.tip {
  font-size: 24rpx; color: var(--ink-2);
  padding: 0 8rpx 24rpx
}

.item { margin-bottom: 20rpx }
.item-name {
  font-size: 28rpx; font-weight: 600; color: var(--ink);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.item-price {
  margin-top: 8rpx; font-size: 28rpx; font-weight: 600; color: var(--accent-deep);
  white-space: nowrap;
  font-family: "Songti SC", "Noto Serif CJK SC", "Times New Roman", serif;
}
.item-remark {
  margin-top: 8rpx; font-size: 24rpx; color: var(--ink-2);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.item-time {
  margin-top: 12rpx; font-size: 22rpx; color: var(--ink-3);
}

.actions {
  margin-top: 24rpx;
  display: flex;
}
.actions .btn { flex: 1; padding: 18rpx 0; font-size: 24rpx; }
.btn-restore {
  background: var(--accent-soft);
  color: var(--accent-deep);
  border: 1rpx solid var(--a-100);
}
.btn-destroy {
  background: var(--s-danger-soft);
  color: var(--danger);
  font-weight: 600;
  border: 1rpx solid var(--s-danger-line);
}

.clear-all {
  margin: 32rpx 0 24rpx; text-align: center;
  font-size: 24rpx; color: var(--danger);
  padding: 24rpx 0
}
.clear-all:active { opacity: 0.7; }

.empty {
  margin-top: 160rpx;
  display: flex; flex-direction: column; align-items: center;
}
.empty-logo { width: 152rpx; height: 152rpx; opacity: 0.45; }
.empty-title { margin-top: 28rpx; font-size: 30rpx; font-weight: 700; color: var(--ink); }
.empty-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-2); }

/* 兼容老客户端：不用 flex 的 gap，改用相邻按钮外边距 */
.btn + .btn { margin-left: 24rpx; }
