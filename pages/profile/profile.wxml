<!--pages/profile/profile.wxml-->
<view class="page">

  <!-- 预览：头像 + 昵称 -->
  <view class="card hero">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill"></image>
      <image wx:else class="avatar avatar-default" src="/images/logo.png" mode="aspectFit"></image>
    </button>

    <view class="hero-name {{nickname ? '' : 'hero-name-empty'}}">{{nickname || '还没起昵称'}}</view>
    <view class="hero-tip">「我的」页会这样显示你</view>

    <view class="hero-actions">
      <button class="mini-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">编辑</button>
    </view>
  </view>

  <!-- 性别：决定下面的昵称推荐 -->
  <view class="card">
    <view class="sec-head">
      <view class="sec-title">我是</view>
    </view>
    <view class="pill-row">
      <view wx:for="{{genders}}" wx:key="key"
            class="pill {{gender === item.key ? 'pill-active' : ''}}"
            data-g="{{item.key}}" bindtap="pickGender">{{item.label}}</view>
    </view>
  </view>

  <!-- 昵称 -->
  <view class="card">
    <view class="sec-head">
      <view class="sec-title">昵称</view>
      <view class="sec-opt">可不填 · 最多 20 字</view>
    </view>

    <view class="input-wrap">
      <input class="field-input" type="nickname" maxlength="20"
             placeholder="给自己起一个昵称" value="{{nickname}}"
             bindinput="onNicknameInput" />
      <view class="input-clear" wx:if="{{nickname}}" bindtap="onClearNickname">×</view>
    </view>

    <view class="divider">
      <view class="divider-text">或挑一个现成的</view>
    </view>

    <view class="pill-row">
      <view wx:for="{{presets}}" wx:key="*this"
            class="pill {{nickname === item ? 'pill-active' : ''}}"
            data-name="{{item}}" bindtap="pickPreset">{{item}}</view>
    </view>
  </view>

  <view class="actions">
    <view class="btn btn-primary btn-block" bindtap="onSave">保存</view>
  </view>

</view>
