/* pages/profile/profile.wxss */

/* 预览卡：头像 + 昵称 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  margin-bottom: 24rpx
}
.avatar-btn {
  position: relative;
  padding: 0;
  margin: 0;
  width: 176rpx;
  height: 176rpx;
  background: transparent;
  line-height: normal;
  overflow: visible;
}
.avatar-btn::after { border: none; }

.avatar {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: var(--accent-soft);
}
.avatar-default {
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--accent-soft);
  border: 2rpx solid var(--n-100);
}
.hero-name {
  margin-top: 24rpx;
  font-size: 40rpx; font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-name-empty { font-weight: 400; color: var(--ink-3); font-size: 32rpx; }
.hero-tip { margin-top: 12rpx; font-size: 22rpx; color: var(--ink-3); }

.hero-actions { margin-top: 24rpx; display: flex; justify-content: center; }
.mini-btn {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 999rpx; background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 24rpx; font-weight: 500;
  line-height: 1.6;
  border: 1rpx solid var(--n-200);
}
.mini-btn::after { border: none; }
.mini-btn:active { background: var(--a-100); }

/* 分区标题 */
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx
}
.sec-title { font-size: 24rpx; font-weight: 600; color: var(--ink); }
.sec-opt { font-size: 22rpx; color: var(--ink-3); }

/* 输入 */
.input-wrap {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
  padding-bottom: 12rpx
}
.field-input {
  flex: 1;
  font-size: 28rpx; color: var(--ink);
  padding: 8rpx 0
}
.input-clear {
  width: 48rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--n-100);
  color: var(--ink-3);
  font-size: 24rpx; line-height: 42rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 分隔 */
.divider {
  margin: 32rpx 0 16rpx
}
.divider-text {
  font-size: 24rpx; color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* 胶囊 */
.pill-row { display: flex; flex-wrap: wrap; margin: -8rpx }
.pill {
  margin: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx; background: var(--n-25);
  color: var(--ink-2);
  font-size: 24rpx; border: 1rpx solid var(--n-100);
}
.pill-active {
  background: var(--accent-soft);
  color: var(--accent-deep);
  border-color: var(--a-100);
  font-weight: 600;
}

.card { margin-bottom: 24rpx }

.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}
.actions .btn { flex: 1; }
