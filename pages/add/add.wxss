/* pages/add/add.wxss */

.card { margin-bottom: 24rpx; }

.field-label {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 16rpx;
}
.opt { color: var(--ink-3); font-size: 24rpx; }

.field-input {
  font-size: 32rpx;
  color: var(--ink);
  padding: 8rpx 0;
}
.field-textarea {
  width: 100%;
  font-size: 28rpx;
  color: var(--ink);
  min-height: 120rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

.dur-row {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}
.dur-pill {
  margin: 8rpx;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #F5F2EC;
  color: var(--ink-2);
  font-size: 28rpx;
  border: 1rpx solid transparent;
}
.dur-active {
  background: var(--accent-soft);
  color: var(--accent-deep);
  border-color: var(--accent);
  font-weight: 600;
}

.actions {
  margin-top: 48rpx;
  display: flex;
  gap: 24rpx;
}
.actions .btn { flex: 1; }
