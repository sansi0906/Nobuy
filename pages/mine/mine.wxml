<!--pages/mine/mine.wxml-->
<view class="page">

  <!-- 头像昵称 -->
  <view class="card me" bindtap="goEditProfile">
    <image wx:if="{{profile.avatar}}" class="me-avatar" src="{{profile.avatar}}" mode="aspectFill"></image>
    <image wx:else class="me-avatar me-avatar-default" src="/images/logo.png" mode="aspectFit"></image>
    <view class="me-info">
      <view class="me-name">{{profile.nickname || '点这里设置昵称和头像'}}</view>
      <view class="me-sub">点这里修改</view>
    </view>
    <view class="me-arrow">›</view>
  </view>

  <!-- 战绩 -->
  <view class="stats">
    <view class="stat">
      <view class="stat-num">{{stats.skipped}}</view>
      <view class="stat-label">忍住了</view>
    </view>
    <view class="stat-div"></view>
    <view class="stat">
      <view class="stat-num">{{stats.bought}}</view>
      <view class="stat-label">我买了</view>
    </view>
    <view class="stat-div"></view>
    <view class="stat">
      <view class="stat-num stat-money">¥{{stats.saved}}</view>
      <view class="stat-label">省下</view>
    </view>
  </view>

  <!-- 数据 -->
  <view class="card">
    <view class="row row-danger" bindtap="clearAll">
      <view class="row-label">清空所有数据</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <!-- 其他 -->
  <view class="card">
    <view class="row" bindtap="goAbout">
      <view class="row-label">关于与联系开发者</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view class="footer">v1.0 · 本地存储版</view>
</view>
