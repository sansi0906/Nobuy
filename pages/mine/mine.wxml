<!--pages/mine/mine.wxml-->
<view class="page">

  <!-- 头像昵称 -->
  <view class="card me" bindtap="goEditProfile">
    <image wx:if="{{profile.avatar}}" class="me-avatar" src="{{profile.avatar}}" mode="aspectFill"></image>
    <image wx:else class="me-avatar me-avatar-default" src="/images/logo.png" mode="aspectFit"></image>
    <view class="me-info">
      <view class="me-name">{{profile.nickname || '点这里设置昵称和头像'}}</view>
      <view class="me-sub" wx:if="{{profile.nickname}}">修改头像与昵称</view>
    </view>
    <view class="me-arrow">›</view>
  </view>

  <!-- 我的记录：战绩、累计省下、省钱战绩入口，合成一张卡 -->
  <view class="card record-card">
    <view class="rec-title">我的记录</view>

    <view class="stats">
      <view class="stat">
        <view class="stat-num">{{stats.skipped}}</view>
        <view class="stat-label">忍住了</view>
      </view>
      <view class="stat-div"></view>
      <view class="stat">
        <view class="stat-num">{{stats.bought}}</view>
        <view class="stat-label">我买了</view>
      </view>
    </view>

    <view class="ach-head">
      <view class="ach-metric">
        <view class="ach-metric-num ach-metric-money">¥{{savedText}}</view>
        <view class="ach-metric-label">累计省下</view>
      </view>
      <view class="ach-metric-div"></view>
      <view class="ach-metric">
        <view class="ach-metric-num">{{streak.longest}}<text class="ach-metric-unit"> 天</text></view>
        <view class="ach-metric-label">最长连续忍住</view>
      </view>
    </view>

    <view class="ach-more" bindtap="goAchievements">
      <view class="ach-more-text">我的战绩</view>
      <view class="ach-more-count">已解锁 {{unlockedCount}}/{{totalAchievements}}</view>
      <view class="ach-more-arrow">›</view>
    </view>
  </view>

  <!-- 数据 -->
  <view class="card">
    <view class="row" bindtap="exportBackup">
      <view class="row-label">导出备份</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row" bindtap="importBackup">
      <view class="row-label">导入备份</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row row-danger" bindtap="clearAll">
      <view class="row-label">清空所有数据</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view class="card-tip">备份包含清单、回收站、分类和个人资料，换手机用它带走；导入会覆盖当前数据。</view>

  <!-- 其他 -->
  <view class="card">
    <view class="row" bindtap="goAbout">
      <view class="row-label">关于</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row" bindtap="showQr">
      <view class="row-label">小程序码</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row row-tap">
      <view class="row-label">联系客服</view>
      <view class="row-arrow">›</view>
      <button class="row-hit" open-type="contact" session-from="mine"></button>
    </view>
  </view>

  <view class="footer">v1.2.0 · 本地存储版</view>

  <!-- 备份 / 恢复选择层：页内自绘，保证转发文件、选文件由用户真点击触发 -->
  <view class="bk-mask" wx:if="{{sheetVisible}}" bindtap="hideSheet">
    <view class="bk-panel" catchtap="noop">
      <view class="bk-head">
        <view class="bk-title">{{sheetTitle}}</view>
        <view class="bk-sub">{{sheetSub}}</view>
      </view>
      <view class="bk-opt" wx:for="{{sheetOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="onSheetTap">
        <view class="bk-opt-main">
          <view class="bk-opt-label">{{item.label}}</view>
          <view class="bk-opt-desc">{{item.desc}}</view>
        </view>
        <view class="bk-opt-arrow">›</view>
      </view>
      <view class="bk-cancel" bindtap="hideSheet">取消</view>
    </view>
  </view>

  <!-- 小程序码弹层 -->
  <view class="qr-mask" wx:if="{{qrVisible}}" bindtap="hideQr">
    <view class="qr-card" catchtap="noop">
      <image class="qr-img" src="/images/miniprogram_qr.png" mode="aspectFit" bindtap="previewQr"></image>
      <view class="qr-title">是不是可以不买</view>
      <view class="qr-sub">微信扫一扫，或保存图片分享给朋友</view>
      <view class="qr-tip">只分享给需要的人，不换取任何奖励</view>
    </view>
  </view>
</view>
